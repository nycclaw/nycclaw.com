{
  "name": "nycclaw",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i src/input.css -o style.css --minify",
    "dev": "npx @tailwindcss/cli -i src/input.css -o style.css --watch & wrangler pages dev .",
    "build": "npm run build:css",
    "deploy": "wrangler pages deploy ."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.0",
    "tailwindcss": "^4.2.0",
    "wrangler": "^3"
  }
}
